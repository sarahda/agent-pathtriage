_scratch/

# resumable measurement caches: large, regenerable, and tied to one code version
*.cache.jsonl

# terraform variable files hold the operator environment (region, names).
# The .example stays tracked so the required variables are discoverable.
*.tfvars
!*.tfvars.example

# session scratch and measurement staging, never part of the artifact
.remeasure/
Claude outputs/

# Raw az role definition dumps carry the subscription id in every entry.
# Commit the filtered, redacted extract instead (infra/foundry/roles-evidence.json).
infra/foundry/roles.json

# one-off probes, not part of the lab
infra/foundry/_probe_*.py
infra/foundry/who_runs.py
infra/foundry/same_project_identity.py

# lab sidecar, regenerated by connect
infra/foundry/runs/.last_connect.json
*.UNREDACTED

# drafts addressed to named people, and their contact details
validation/sends/

# cell outputs: regenerable, and they carry the account id
runs/
